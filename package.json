{
  "name": "yeet-arena",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:client": "npm run dev --workspace=@yeet-arena/client",
    "dev:server": "npm run dev --workspace=@yeet-arena/server",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@yeet-arena/shared",
    "build:client": "npm run build --workspace=@yeet-arena/client",
    "build:server": "npm run build --workspace=@yeet-arena/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  }
}
